/target

# Local config with chat credentials — copy config.example.toml instead.
/config.toml

# Data: databases, per-frame observation logs, runtime logs
*.db
*.db-shm
*.db-wal
*.jsonl
/logs/
/backfill-logs/
/calibration/

# Generated site output (index.html is built from template.html + the db;
# arcathlon/ and rando/ are one page per event from event.html; site/api/
# holds the machine-readable projections; site/static/ is tracked)
/site/index.html
/site/data.json
/site/api/
/site/arcathlon/
/site/rando/
/site/game/

# Local screenshots / scratch — but the glyph reader's test crops are kept
*.png
*.jpg
*.jpeg
!/tests/fixtures/**/*.png
/.playwright-mcp/
nohup.out

# Backfill working set (per-VOD databases and import marks)
/backfill-db/

# Downloaded VODs for file-source analysis
/vods/

# Build lock and the alternate build trees
/.build-site.lock
/target-leptess/
/target-*/

# Replay-window work files (configs, dbs, obs logs per replay)
/replays/

# Marathon replay working set (scripts/replay-arcathlon.sh). ARCA_OUT names
# the directory, so a second pass over the same broadcasts lands beside the
# first rather than over it.
/arcathlon-db*/

# Database backups (scripts/backup-db.sh) and retired copies
/backups/

# Agent worktrees the tooling places inside the repository
/.claude/
