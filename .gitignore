/target

# Local config with chat credentials — copy config.example.toml instead.
/config.toml

# Data: databases, per-frame observation logs, runtime logs
*.db
*.db-shm
*.db-wal
*.jsonl
/logs/
/backfill-logs/
/calibration/

# Generated site output (index.html is built from template.html + the db;
# site/api/ holds the machine-readable projections; site/static/ is tracked)
/site/index.html
/site/data.json
/site/api/

# Local screenshots / scratch — but the glyph reader's test crops are kept
*.png
*.jpg
*.jpeg
!/tests/fixtures/**/*.png
/.playwright-mcp/
nohup.out

# Backfill working set (per-VOD databases and import marks)
/backfill-db/

# Downloaded VODs for file-source analysis
/vods/

# Build lock and the alternate build trees
/.build-site.lock
/target-leptess/
/target-*/

# Replay-window work files (configs, dbs, obs logs per replay)
/replays/

# Database backups (scripts/backup-db.sh) and retired copies
/backups/
