# grindlog: the reference deployment's schedule. Install or refresh with
# scripts/install-cron.sh, which replaces every line mentioning
# ngtwitchtimer/scripts in the user's crontab with these. Paths are the
# reference box's; edit REPO for another checkout.
#
# Grind Log: the supervisor survives everything but a reboot; this brings it back in its tmux session.
@reboot sleep 30 && cd /datar/workspace/claude_code_experiments/ngtwitchtimer && tmux new-session -d -s ngtimer ./scripts/run-live.sh
# Grind Log: deploy the site every ten minutes while a live session is open.
*/10 * * * * PATH="/home/bryan/.local/bin:/usr/bin:/bin" /datar/workspace/claude_code_experiments/ngtwitchtimer/scripts/deploy-if-live.sh >> /datar/workspace/claude_code_experiments/ngtwitchtimer/logs/deploy.log 2>&1
# Grind Log: nightly deploy, then a backup of the database.
50 23 * * * PATH="/home/bryan/.local/bin:/usr/bin:/bin" /datar/workspace/claude_code_experiments/ngtwitchtimer/scripts/deploy-site.sh >> /datar/workspace/claude_code_experiments/ngtwitchtimer/logs/deploy.log 2>&1
55 23 * * * PATH="/home/bryan/.local/bin:/usr/bin:/bin" /datar/workspace/claude_code_experiments/ngtwitchtimer/scripts/backup-db.sh >> /datar/workspace/claude_code_experiments/ngtwitchtimer/logs/backup.log 2>&1
